# Safe template — copy to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real credentials.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
BETTER_AUTH_SECRET=<random secret>
BETTER_AUTH_URL=http://localhost:3000
JWT_SECRET=<must exactly match the server JWT_SECRET>
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth (required for social login)
GOOGLE_CLIENT_ID=<google oauth client id>
GOOGLE_CLIENT_SECRET=<google oauth client secret>

# Optional: enables cover file upload; paste-image-URL works without it
IMGBB_API_KEY=
